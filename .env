# -------------------------------------------------------------------------
# Общие настройки
# -------------------------------------------------------------------------

# Часовой пояс
TIME_ZONE=Europe/Moscow

# Базовый домен
#
# Требования для маршрутизации по доменным именам:
# 1. Запущенный глобальный сервис Traefik
# 2. Wildcard-запись DNS *.kolka.local на IP-адрес хост-сервера
BASE_DOMAIN=kolka.local


# -------------------------------------------------------------------------
# Пользовательская страница
# -------------------------------------------------------------------------

# Порты: панель управления
VIEWER_DASHBOARD_HOST_PORT=3340
VIEWER_DASHBOARD_CONTAINER_PORT=8000


# -------------------------------------------------------------------------
# Программный интерфейс
# -------------------------------------------------------------------------

# Порты: программный интерфейс
INTERFACE_HOST_PORT=3341
INTERFACE_CONTAINER_PORT=8000

# Домены: программный интерфейс
INTERFACE_DOMAIN=interface.telemetry.${BASE_DOMAIN}

# Базовый адрес для доступа к данным
INTERFACE_BASE_URL=http://interface:${INTERFACE_CONTAINER_PORT}


# -------------------------------------------------------------------------
# Служба обработки данных: FTP Ресурс (метеорологические данные)
# -------------------------------------------------------------------------

# Хост FTP сервера
INGESTOR_FTP_HOST_ADDRESS=87.117.41.216  # Или локальный адрес: 192.168.23.3

# Учетные данные
INGESTOR_FTP_HOST_USER=efu
INGESTOR_FTP_HOST_PASSWORD=eup

# Каталог для мониторинга XML-файлов на сервере
INGESTOR_FTP_HOST_XML_PATH=/meteo

# Каталог для мониторинга JPG-файлов на сервере
INGESTOR_FTP_HOST_JPG_PATH=/cameratrap


# -------------------------------------------------------------------------
# Служба обработки данных: планировщик (расписание запусков)
# -------------------------------------------------------------------------

# Нативная cron-строка для планировщика supercronic
# Формат: минута час день месяц день_недели
# Текущее значение: 10-я минута каждого 3-го часа, начиная с 00:10
# INGESTOR_CRON_SCHEDULE=*/3 * * * *  # Быстрое наполнение базы для тестового запуска
INGESTOR_CRON_SCHEDULE=10 0,3,6,9,12,15,18,21 * * *  # Обычный режим работы

# Удалять исходный архив после успешной распаковки (True/False)
# Если установлено False, архив будет перемещен в каталог обработанных файлов
INGESTOR_DELETE_PROCESSED_ARCHIVES=False

# Немедленный запуск при старте контейнера (true/false)
# Установи true при первом деплое, чтобы сразу наполнить систему данными
INGESTOR_RUN_ON_STARTUP=true


# -------------------------------------------------------------------------
# Менеджер базы данных
# -------------------------------------------------------------------------

# Порты: панель управления
DATABASE_MANAGER_DASHBOARD_HOST_PORT=3342
DATABASE_MANAGER_DASHBOARD_CONTAINER_PORT=80

# Домены: панель управления
DATABASE_MANAGER_DASHBOARD_DOMAIN=database.${BASE_DOMAIN}

# Учётные данные
DATABASE_MANAGER_DEFAULT_EMAIL=admin@${BASE_DOMAIN}
DATABASE_MANAGER_DEFAULT_PASSWORD=cesspool-procreate-brook-saloon-cramp


# -------------------------------------------------------------------------
# База данных
# -------------------------------------------------------------------------

# Порты: программный интерфейс
DATABASE_INTERFACE_HOST_PORT=3343
DATABASE_INTERFACE_CONTAINER_PORT=5432

# Адрес базы данных внутри сети контейнеров
DATABASE_INTERFACE_HOST=database

# Учётные данные
DATABASE_DEFAULT_NAME=kolka_telemetry
DATABASE_DEFAULT_USER=admin
DATABASE_DEFAULT_PASSWORD=cesspool-procreate-brook-saloon-cramp

# Строка соединения для внешних клиентов и асинхронных библиотек.
# Django использует отдельные параметры выше.
DATABASE_INTERFACE_DSN=postgresql+asyncpg://${DATABASE_DEFAULT_USER}:${DATABASE_DEFAULT_PASSWORD}@database:${DATABASE_INTERFACE_CONTAINER_PORT}/${DATABASE_DEFAULT_NAME}


# -------------------------------------------------------------------------
# Объектное хранилище
# -------------------------------------------------------------------------

# Порты: панель управления
OBJECT_STORAGE_DASHBOARD_HOST_PORT=3344
OBJECT_STORAGE_DASHBOARD_CONTAINER_PORT=9001

# Порты: программный интерфейс
OBJECT_STORAGE_INTERFACE_HOST_PORT=3345
OBJECT_STORAGE_INTERFACE_CONTAINER_PORT=9000

# Домены: панель управления
OBJECT_STORAGE_DASHBOARD_DOMAIN=storage.kolka.${BASE_DOMAIN}

# Домены: программный интерфейс
OBJECT_STORAGE_INTERFACE_DOMAIN=interface.storage.kolka.${BASE_DOMAIN}

# Учётные данные
OBJECT_STORAGE_BUCKET=kolka-telemetry-files
OBJECT_STORAGE_DEFAULT_USER=admin
OBJECT_STORAGE_DEFAULT_PASSWORD=12HowSoonIsNow

# Параметры соединения
OBJECT_STORAGE_BASE_URL=object-storage:${OBJECT_STORAGE_INTERFACE_CONTAINER_PORT}
OBJECT_STORAGE_USE_SSL=False
