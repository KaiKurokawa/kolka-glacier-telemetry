# -------------------------------------------------------------------------
# Универсальный многоэтапный Dockerfile для приложения на FastAPI
# -------------------------------------------------------------------------
# Данная конфигурация реализует оптимизированную двухэтапную сборку 
# (Multi-stage build) для Python-приложений, использующих компилируемые 
# C-расширения (включая asyncpg, greenlet, psycopg2). 
# Обеспечивает минимальный размер финального образа и изолирует 
# инструменты компиляции от рантайм-среды в целях безопасности.


# -------------------------------------------------------------------------
# Сборка и изоляция зависимостей
# -------------------------------------------------------------------------

# Инициализация базового образа для этапа сборки зависимостей
FROM python:3.14-slim AS builder

# Установка изолированной рабочей директории для сборки проекта
WORKDIR /build

# Установка системных пакетов, необходимых для компиляции C-расширений (asyncpg/greenlet)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Копирование файла со списком зависимостей в рабочую директорию сборщика
COPY requirements.txt .

# Установка зависимостей в изолированную директорию пользователя
RUN pip install --no-cache-dir --user -r requirements.txt


# -------------------------------------------------------------------------
# Легковесная среда исполнения
# -------------------------------------------------------------------------

# Инициализация чистого базового образа для финальной среды исполнения
FROM python:3.14-slim AS runtime

# Установка рабочей директории для размещения исходного кода приложения
WORKDIR /interface

# Установка минимального набора системных библиотек для работы клиента PostgreSQL
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Копирование скомпилированных Python-пакетов из этапа сборщика
COPY --from=builder /root/.local /root/.local
COPY --from=builder /build/requirements.txt ./requirements.txt

# Интеграция пути к бинарным файлам пользователя и отключение буферизации логов Python
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1

# Копирование исходного кода приложения в рабочую директорию
COPY . /interface

# Открытие сетевого порта приложения для маршрутизации трафика
EXPOSE 8000

# Запуск ASGI-сервера Uvicorn на интерфейсе 0.0.0.0 для обеспечения сетевой доступности контейнера
CMD ["uvicorn", "codebase.main:application", "--host", "0.0.0.0", "--port", "8000"]
